{
	"name": "pi-exit-resume",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Pi extension that copies the resume command when Pi exits.",
	"keywords": ["pi-package", "pi-extension"],
	"files": ["src", "README.md"],
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware --tsconfig tsconfig.json .",
		"format": "dprint fmt .",
		"format:check": "dprint check .",
		"dupes": "jscpd --config .jscpd.json .",
		"unused": "knip"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.74.0",
		"@types/node": "latest",
		"dprint": "latest",
		"jscpd": "latest",
		"knip": "latest",
		"oxlint": "latest",
		"oxlint-plugin-complexity": "latest",
		"oxlint-plugin-inhuman": "latest",
		"oxlint-tsgolint": "latest",
		"typescript": "latest"
	}
}
